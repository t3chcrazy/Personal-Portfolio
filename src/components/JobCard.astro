---
export interface Props {
    job: {
        company: string;
        tenure: string;
        title: string;
        highlight: string;
        skills: string[];
        bg: string;
        points: string[];
    };
    index: number;
}
const { job: { company, tenure, title, highlight, skills, bg, points }, index } = Astro.props
---
<li class = "jobCard" style = {`--card-bg:${bg}; --stack-index:${index}`}>
    <div class = "jobVisual">
        <span class = "jobInitial">{company.charAt(0)}</span>
        <span class = "jobTenure">{tenure}</span>
    </div>
    <div class = "jobContent">
        <div class = "jobContentTop">
            <h3>{company}</h3>
            <span class = "role">{title}</span>
        </div>
        <p class = "highlight">{highlight}</p>
        <ul class = "cardPoints">
            {points.map((point: string) => <li>{point}</li>)}
        </ul>
        <ul class = "skillTags">
            {skills.map((skill: string) => <li>{skill}</li>)}
        </ul>
    </div>
</li>
<style>
    .jobCard {
        list-style: none;
        display: flex;
        border-radius: var(--radius-md);
        overflow: clip;
        box-shadow: var(--shadow-sm);
        background-color: var(--bg-elevated, var(--color-white));
        opacity: 0;
        transform: translateY(24px);
        transition: opacity var(--duration-slow) var(--spring), transform var(--duration-slow) var(--spring);
        transition-delay: var(--reveal-delay, 0ms);
        position: sticky;
        top: calc(100px + var(--stack-index) * 26px);
        z-index: calc(var(--stack-index) + 1);
        margin-bottom: 32px;
    }
    .jobCard.cardRevealed {
        opacity: var(--stack-fade, 1);
        transform: scale(var(--stack-scale, 1));
    }
    .jobVisual {
        flex: 0 0 260px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 32px;
        background-color: var(--card-bg);
    }
    .jobInitial {
        font-size: 4rem;
        font-weight: 700;
        line-height: 1;
        color: var(--color-dark);
    }
    .jobTenure {
        color: rgba(29, 29, 29, 0.6);
        font-size: 0.85rem;
        white-space: nowrap;
    }
    .jobContent {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 32px;
    }
    .jobContentTop {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }
    h3 {
        color: var(--primary);
        font-size: 1.3rem;
    }
    .role {
        color: var(--secondary);
        font-weight: 600;
        white-space: nowrap;
    }
    .highlight {
        color: var(--secondary);
        line-height: 1.5;
        margin: 0;
    }
    .cardPoints {
        display: none;
        list-style: none;
        flex-direction: column;
        gap: 10px;
        padding: 0;
        margin: 0;
    }
    .cardPoints > li {
        position: relative;
        padding-left: 20px;
        color: var(--secondary);
        line-height: 1.5;
        font-size: 0.92rem;
    }
    .cardPoints > li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.5em;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: var(--cta-bg);
    }
    .skillTags {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 0;
        margin-top: auto;
        padding-top: 8px;
    }
    .skillTags > li {
        padding: 5px 12px;
        border-radius: 999px;
        background-color: var(--color-blue);
        color: var(--color-dark);
        font-size: 0.82rem;
        font-weight: 500;
    }
    @media only screen and (max-width: 1299px) {
        .jobCard {
            position: static;
            flex-direction: column;
            margin-bottom: 0;
            border-radius: 20px;
            opacity: 1;
            transform: none;
        }
        .jobCard.cardRevealed {
            opacity: 1;
            transform: none;
        }
        .jobVisual {
            flex: none;
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
            padding: 24px 28px;
            border-radius: 20px 20px 0 0;
        }
        .jobInitial {
            font-size: 3rem;
        }
        .jobContent {
            gap: 16px;
            padding: 24px 28px 28px;
        }
        .cardPoints {
            display: flex;
        }
    }
    @media only screen and (max-width: 768px) {
        .jobInitial {
            font-size: 2.5rem;
        }
    }
</style>
