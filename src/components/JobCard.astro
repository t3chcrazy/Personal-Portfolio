---
export interface Props {
    job: {
        company: string;
        tenure: string;
        title: string;
        highlight: string;
        skills: string[];
        bg: string;
    };
}
const { job: { company, tenure, title, highlight, skills, bg } } = Astro.props
---
<li class = "jobCard" style = {`--card-bg:${bg}`}>
    <div class = "jobCardTop">
        <h3>{company}</h3>
        <span class = "tenure">{tenure}</span>
    </div>
    <p class = "role">{title}</p>
    <p class = "highlight">{highlight}</p>
    <ul class = "skillTags">
        {skills.map((skill: string) => <li>{skill}</li>)}
    </ul>
</li>
<style>
    .jobCard {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 32px;
        border-radius: var(--radius-md);
        background-color: var(--card-bg);
        opacity: 0;
        transform: translateY(24px);
        transition: opacity var(--duration-slow) var(--spring), transform var(--duration-slow) var(--spring);
        transition-delay: var(--reveal-delay, 0ms);
    }
    .jobCard.cardRevealed {
        opacity: 1;
        transform: translateY(0);
    }
    .jobCardTop {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
    }
    h3 {
        color: var(--color-dark);
        font-size: 1.3rem;
    }
    .tenure {
        color: rgba(29, 29, 29, 0.6);
        font-size: 0.85rem;
        white-space: nowrap;
    }
    .role {
        color: rgba(29, 29, 29, 0.75);
        font-weight: 600;
        margin: 0;
    }
    .highlight {
        color: rgba(29, 29, 29, 0.7);
        line-height: 1.5;
        margin: 0;
    }
    .skillTags {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 0;
        margin-top: auto;
        padding-top: 8px;
    }
    .skillTags > li {
        padding: 5px 12px;
        border-radius: 999px;
        background-color: rgba(255, 255, 255, 0.6);
        color: var(--color-dark);
        font-size: 0.82rem;
        font-weight: 500;
    }
    :global(html[data-theme="dark"]) .skillTags > li {
        background-color: rgba(0, 0, 0, 0.15);
    }
</style>
