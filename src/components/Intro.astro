---
import myImage from '../images/myPhoto.webp'
import { Image } from 'astro:assets';

const splitWords = (text: string) => text.split(" ")
const role = splitWords("a software engineer.")
const tagline = splitWords("I specialize in React, React-Native, and full-stack web development, with a strong track record of shipping products that scale.")
---
<section id = "heroSection" class = "fullHeightSection">
    <div class = "badgeDot dotYellow" aria-hidden = "true"></div>
    <div class = "badgeDot dotPink" aria-hidden = "true"></div>
    <div class = "badgeDot dotLime" aria-hidden = "true"></div>
    <div class = "introContent">
        <div class = "topRow">
            <h1 class = "display1 word" style = "--i:0">Hello!</h1>
            <span class = "avatar word" style = "--i:1">
                <Image src = {myImage} alt = "" loading = "eager" width = {105} height = {105} />
            </span>
            <h1 class = "display1 word" style = "--i:2">I'm Abhishek,</h1>
        </div>
        <h1 class = "display1 rolePhrase">
            {role.map((word, i) => <span class = "word" style = {`--i:${i + 3}`}>{word}&nbsp;</span>)}
        </h1>
        <p class = "bodyLg tagline">
            {tagline.map((word, i) => <span class = "word" style = {`--i:${i + 6}`}>{word}&nbsp;</span>)}
        </p>
        <div class = "ctaRow">
            <a class = "ctaPrimary" href = "#workSection">See my work</a>
            <a class = "ctaSecondary" href = "#contactSection">Get in touch</a>
        </div>
    </div>
    <a href = "#aboutSection" class = "scrollCue" aria-label = "Scroll to about section">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 4v16M6 14l6 6 6-6"></path>
        </svg>
    </a>
</section>
<style>
    #heroSection {
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
        overflow: clip;
        background-color: var(--color-purple);
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        padding-top: calc(2rem + 140px);
    }
    :global(html[data-theme="dark"]) #heroSection {
        background-color: var(--bg-inset);
    }
    .badgeDot {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
        opacity: 0;
        animation: dotIn 1.1s forwards var(--spring);
    }
    .dotYellow {
        width: 70px;
        height: 70px;
        background-color: var(--color-yellow);
        top: 18%;
        left: 8%;
        animation-delay: 0.9s;
    }
    .dotPink {
        width: 46px;
        height: 46px;
        background-color: var(--color-pink);
        bottom: 20%;
        left: 14%;
        animation-delay: 1.05s;
    }
    .dotLime {
        width: 56px;
        height: 56px;
        background-color: var(--color-lime);
        top: 22%;
        right: 10%;
        animation-delay: 1s;
    }
    @keyframes dotIn {
        0% {
            opacity: 0;
            transform: scale(0.6);
        }
        100% {
            opacity: 1;
            transform: scale(1);
        }
    }
    .introContent {
        position: relative;
        z-index: 1;
        max-width: 820px;
        margin: 0 auto;
        text-align: center;
        padding: 40px 0;
    }
    .topRow {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 20px;
        flex-wrap: wrap;
    }
    .avatar {
        display: inline-flex;
        width: 84px;
        height: 84px;
        border-radius: 50%;
        overflow: hidden;
        border: 3px solid var(--color-white);
        box-shadow: var(--shadow-sm);
        flex-shrink: 0;
    }
    .avatar :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    h1.display1 {
        color: var(--primary);
        margin: 0;
    }
    .rolePhrase {
        color: var(--secondary);
    }
    .tagline {
        color: var(--secondary);
        margin-top: 28px;
    }
    .word {
        display: inline-block;
        opacity: 0;
        filter: blur(6px);
        transform: translateY(14px);
        animation: wordIn var(--duration-spring) forwards var(--spring);
        animation-delay: calc(var(--i) * 55ms + 150ms);
    }
    @keyframes wordIn {
        to {
            opacity: 1;
            filter: blur(0);
            transform: translateY(0);
        }
    }
    .ctaRow {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-top: 2.5rem;
        opacity: 0;
        animation: fadeUp 0.7s forwards var(--spring);
        animation-delay: 1.5s;
    }
    @keyframes fadeUp {
        0% {
            opacity: 0;
            transform: translateY(16px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .ctaPrimary, .ctaSecondary {
        display: inline-flex;
        align-items: center;
        padding: 0.85rem 1.7rem;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 600;
        transition: transform var(--duration-fast) var(--spring), box-shadow var(--duration-fast) var(--ease), background-color var(--duration-fast) var(--ease);
    }
    .ctaPrimary {
        background-color: var(--cta-bg);
        color: var(--cta-text);
        box-shadow: var(--shadow-sm);
    }
    .ctaPrimary:hover, .ctaPrimary:focus-visible {
        background-color: var(--cta-bg-hover);
        transform: translateY(-3px);
        box-shadow: var(--shadow-md);
    }
    .ctaSecondary {
        color: var(--primary);
        border: 1px solid var(--border-color);
        background-color: var(--color-white);
    }
    :global(html[data-theme="dark"]) .ctaSecondary {
        background-color: var(--bg-elevated);
    }
    .ctaSecondary:hover, .ctaSecondary:focus-visible {
        background-color: var(--color-blue-hover);
        transform: translateY(-3px);
        box-shadow: var(--shadow-sm);
    }
    .scrollCue {
        position: absolute;
        bottom: 2rem;
        left: 50%;
        transform: translateX(-50%);
        color: var(--secondary);
        animation: bob 2s ease-in-out infinite;
    }
    .scrollCue svg {
        width: 24px;
        height: 24px;
    }
    @keyframes bob {
        0%, 100% {
            transform: translate(-50%, 0);
        }
        50% {
            transform: translate(-50%, 8px);
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .scrollCue {
            animation: none;
        }
        .word, .badgeDot, .ctaRow {
            animation: none;
            opacity: 1;
            filter: none;
            transform: none;
        }
    }
    @media only screen and (max-width: 576px) {
        .scrollCue {
            display: none;
        }
        .badgeDot {
            display: none;
        }
        .topRow {
            gap: 12px;
        }
        .avatar {
            width: 56px;
            height: 56px;
        }
    }
</style>
