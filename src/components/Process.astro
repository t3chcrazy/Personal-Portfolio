---
const STATS = [
    { number: "6+", label: "Years of experience", bg: "var(--color-blue)" },
    { number: "5", label: "Companies worked with", bg: "var(--color-yellow)" },
    { number: "15+", label: "Technologies used", bg: "var(--color-pink)" }
]
---
<section id = "processSection">
    <div class = "processIntro">
        <h2 class = "display3">High-quality work with real value considered.</h2>
        <p class = "bodyLg">
            My approach revolves around maximizing productivity and craft with clarity and focus, starting from thorough requirement gathering, through careful implementation, to code that's built to last.
        </p>
    </div>
    <div class = "statsBlock">
        <h3 class = "handwritten">My numbers say it all</h3>
        <ul class = "statsRow">
            {STATS.map((stat, i) => (
                <li style = {`--stat-bg:${stat.bg};--stat-i:${i}`}>
                    <span class = "statCircle">{stat.number}</span>
                    <span class = "statLabel">{stat.label}</span>
                </li>
            ))}
        </ul>
    </div>
</section>
<script>
    const stats = Array.from(document.querySelectorAll("#processSection .statsRow li"))
    const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add("statIn")
                obs.unobserve(entry.target)
            }
        })
    }, { threshold: 0.3 })
    stats.forEach(stat => observer.observe(stat))
</script>
<style>
    #processSection {
        display: flex;
        flex-direction: column;
        gap: 60px;
        align-items: center;
        text-align: center;
    }
    .processIntro {
        max-width: 720px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
    .processIntro p {
        color: var(--secondary);
    }
    .statsBlock {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 24px;
    }
    .handwritten {
        font-family: var(--font-hand);
        font-size: clamp(22px, 2.5vw, 28px);
        font-weight: 600;
        color: var(--primary);
        margin: 0;
    }
    .statsRow {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 18px;
        padding: 0;
        margin: 0;
        max-width: 820px;
    }
    .statsRow > li {
        display: inline-flex;
        align-items: center;
        gap: 16px;
        padding: 10px 28px 10px 10px;
        border-radius: 999px;
        background-color: var(--bg-elevated);
        border: 1px solid var(--border-color);
        box-shadow: var(--shadow-sm);
        opacity: 0;
        transform: translateY(18px) scale(0.94);
        transition: transform var(--duration-spring) var(--spring), opacity var(--duration-spring) var(--spring), box-shadow var(--duration-fast) var(--ease);
    }
    .statsRow > li.statIn {
        opacity: 1;
        transform: none;
        transition-delay: calc(var(--stat-i, 0) * 110ms);
    }
    .statsRow > li:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-md);
    }
    .statCircle {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 68px;
        height: 68px;
        border-radius: 50%;
        background-color: var(--stat-bg);
        color: var(--color-dark);
        font-size: 1.35rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        transition: transform var(--duration-base) var(--ease-out-back);
    }
    .statsRow > li.statIn .statCircle {
        animation: statPop var(--duration-base) var(--ease-out-back) backwards;
        animation-delay: calc(var(--stat-i, 0) * 110ms + 120ms);
    }
    @keyframes statPop {
        0% { transform: scale(0.6); }
        100% { transform: scale(1); }
    }
    .statLabel {
        color: var(--secondary);
        font-size: 0.95rem;
        text-align: left;
        line-height: 1.3;
        max-width: 12ch;
    }
    @media only screen and (max-width: 576px) {
        .statsRow {
            flex-direction: column;
            align-items: stretch;
        }
        .statsRow > li {
            justify-content: flex-start;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .statsRow > li {
            opacity: 1;
            transform: none;
            transition: none;
        }
        .statsRow > li.statIn .statCircle {
            animation: none;
        }
    }
</style>
