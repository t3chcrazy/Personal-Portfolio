---
import Svg from '@jasikpark/astro-svg-loader'

const SOCIALS = [
    {
        icon: import('../images/mail.svg?raw'),
        link: "mailto:abhishekprashant09@gmail.com",
        alt: "Mail",
        bg: "var(--color-blue)"
    },
    {
        icon: import('../images/twitter.svg?raw'),
        link: "https://twitter.com/The1WhoIsMany",
        alt: "Twitter",
        bg: "var(--color-pink)"
    },
    {
        icon: import('../images/linkedin.svg?raw'),
        link: "https://linkedin.com/in/abhishek-prashant-92b152a9",
        alt: "Linkedin",
        bg: "var(--color-yellow)"
    },
    {
        icon: import('../images/github.svg?raw'),
        link: "https://github.com/t3chcrazy",
        alt: "Github",
        bg: "var(--color-lime)"
    }
]
---
<section id = "contactSection" class = "fullHeightSection">
    <p class = "handwritten">Happy to connect!</p>
    <div class = "bottomSection">
        <h2 class = "display3">Get in touch</h2>
        <div>
            Open to new opportunities and always happy to connect with like-minded people
        </div>
        <a class = "ctaPrimary" href = "mailto:abhishekprashant09@gmail.com">Say hello</a>
    </div>
    <ul class = "socialsList">
        {SOCIALS.map(social => (
            <li style = {`--pill-bg:${social.bg}`}>
                <a href = {social.link} target = "_blank" rel="noopener" aria-label = {social.alt}>
                    <Svg
                        src = {social.icon}
                        aria-hidden = "true"
                    />
                </a>
            </li>
        ))}
    </ul>
</section>
<style>
    #contactSection {
        display: flex;
        flex-flow: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        background-color: var(--color-green);
        border-radius: var(--radius-lg);
        padding: 80px 40px;
    }
    :global(html[data-theme="dark"]) #contactSection {
        background-color: var(--bg-inset);
    }
    ul {
        list-style: none;
        display: flex;
        align-items: center;
        padding: 0;
        column-gap: 14px;
    }
    li a {
        display: grid;
        place-items: center;
        width: 46px;
        height: 46px;
        border-radius: 50%;
        color: var(--color-dark);
        background-color: var(--pill-bg, var(--color-blue));
        transition: transform var(--duration-fast) var(--spring), box-shadow var(--duration-fast) var(--ease);
    }
    li svg {
        width: 20px;
        height: 20px;
    }
    li a:hover, li a:focus-visible {
        transform: translateY(-5px) rotate(-6deg);
        box-shadow: var(--shadow-md);
    }
    .handwritten {
        font-family: var(--font-hand);
        font-size: clamp(22px, 2.5vw, 28px);
        font-weight: 600;
        color: var(--primary);
        margin: 0;
    }
    .bottomSection {
        display: inherit;
        flex-flow: column;
        align-items: center;
        margin-top: 12px;
        margin-bottom: 40px;
    }
    .bottomSection > h2 {
        color: var(--primary);
    }
    .bottomSection > div {
        color: var(--secondary);
        line-height: 1.4;
        width: 60%;
        text-align: center;
        margin-top: 1rem;
    }
    .ctaPrimary {
        display: inline-flex;
        align-items: center;
        margin-top: 1.75rem;
        padding: 0.85rem 1.7rem;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 600;
        background-color: var(--cta-bg);
        color: var(--cta-text);
        box-shadow: var(--shadow-sm);
        transition: transform var(--duration-fast) var(--spring), box-shadow var(--duration-fast) var(--ease), background-color var(--duration-fast) var(--ease);
    }
    .ctaPrimary:hover, .ctaPrimary:focus-visible {
        background-color: var(--cta-bg-hover);
        transform: translateY(-3px);
        box-shadow: var(--shadow-md);
    }
</style>