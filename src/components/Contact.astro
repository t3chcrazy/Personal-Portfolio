---
import Svg from '@jasikpark/astro-svg-loader'

const SOCIALS = [
    {
        icon: import('../images/mail.svg?raw'),
        link: "mailto:abhishekprashant09@gmail.com",
        alt: "Mail"
    },
    {
        icon: import('../images/twitter.svg?raw'),
        link: "https://twitter.com/The1WhoIsMany",
        alt: "Twitter"
    },
    {
        icon: import('../images/linkedin.svg?raw'),
        link: "https://linkedin.com/in/abhishek-prashant-92b152a9",
        alt: "Linkedin"
    },
    {
        icon: import('../images/github.svg?raw'),
        link: "https://github.com/t3chcrazy",
        alt: "Github"
    }
]
---
<section id = "contactSection" class = "fullHeightSection">
    <h3>Happy to connect!</h3>
    <div class = "bottomSection">
        <h1>Get in touch</h1>
        <div>
            I am looking forward to connect with like minded people
        </div>
    </div>
    <ul class = "socialsList">
        {SOCIALS.map(social => (
            <li>
                <a href = {social.link} target = "_blank" rel="noopener" aria-label = {social.alt}>
                    <Svg
                        src = {social.icon}
                        aria-hidden = "true"
                    />
                </a>
            </li>
        ))}
    </ul>
</section>
<style>
    #contactSection {
        display: flex;
        flex-flow: column;
        align-items: center;
        justify-content: center;
    }
    ul {
        list-style: none;
        display: flex;
        align-items: center;
        padding: 0;
        column-gap: 14px;
    }
    li a {
        display: grid;
        place-items: center;
        width: 46px;
        height: 46px;
        border-radius: 50%;
        color: var(--secondary);
        background-color: var(--bg-elevated);
        border: 1px solid var(--border-color);
        transition: transform var(--duration-fast) var(--ease), color var(--duration-fast) var(--ease), box-shadow var(--duration-fast) var(--ease);
    }
    li svg {
        width: 20px;
        height: 20px;
    }
    li a:hover, li a:focus-visible {
        transform: translateY(-5px);
        color: var(--brand-green);
        box-shadow: var(--shadow-md);
    }
    h3 {
        font-size: 24px;
    }
    .bottomSection {
        display: inherit;
        flex-flow: column;
        align-items: center;
        margin-top: 20px;
        margin-bottom: 40px;
    }
    .bottomSection > h1 {
        font-size: 48px;
        color: var(--secondary);
    }
    .bottomSection > div {
        color: var(--brand-green);
        line-height: 1.3;
        width: 60%;
        text-align: center;
        margin-top: 1rem;
    }
</style>