---
import myImage from '../images/myPhoto.webp'
import { Image } from 'astro:assets';
const SKILLS = {
    Languages: ["JavaScript", "TypeScript", "Go", "HTML", "CSS"],
    Frameworks: ["React", "React Native", "Redux", "Zustand", "Reanimated"],
    Tools: ["Git", "Jenkins", "GitHub Actions", "ArgoCD", "MongoDB", "MySQL"]
}
const PILL_COLORS = ["var(--color-blue)", "var(--color-yellow)", "var(--color-green)", "var(--color-pink)", "var(--color-lime)"]
---
<section id = "aboutSection">
    <div class = "aboutTop">
        <aside class = "aboutText">
            <p class = "handwritten">Hey! That's me.</p>
            <h2 class = "display3 leftAlign">Abhishek Prashant</h2>
            <p class = "bio">
                I'm a software engineer who enjoys creating delightful experiences for people through code.
                I got interested in app development after following a <a class = "underlineLink" href = "https://fullstackopen.com/en/" target = "_blank">free course</a> online
                and got fully committed to it, never looking back.
            </p>
            <p class = "bio">
                My journey has been shaped by shipping real products end to end, from lending flows used by banks and NBFCs,
                to consumer apps and internal dashboards that teams rely on daily. I'm always looking to grow and explore new opportunities.
            </p>
        </aside>
        <aside class = "aboutImage">
            <Image
                src = {myImage}
                alt = "Portrait of Abhishek Prashant"
                loading = "lazy"
                width = {420}
                height = {420}
            />
            <span class = "availabilityBadge">
                <span class = "availabilityDot" aria-hidden = "true"></span>
                Open to work
            </span>
        </aside>
    </div>
    <div class = "sectionDivider" aria-hidden = "true"></div>
    <div class = "capabilities">
        <h3 class = "handwritten">My capabilities</h3>
        <p class = "bodyLg">
            The skills I bring are tailored to <strong>real product needs</strong>, from pixel-perfect UI to scalable backend systems.
        </p>
        <div class = "skillSection">
            {Object.keys(SKILLS).map((key, groupIndex) => (
                <div class = "subSection" style = {`--section-accent:${PILL_COLORS[groupIndex % PILL_COLORS.length]}`}>
                    <h4>{key}</h4>
                    <ul>
                        {SKILLS[key as keyof typeof SKILLS].map((skill: string, skillIndex: number) => (
                            <li style = {`--pill-bg:${PILL_COLORS[groupIndex % PILL_COLORS.length]};--pill-i:${skillIndex}`}>{skill}</li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>
    </div>
</section>
<script>
    const pills = Array.from(document.querySelectorAll("#aboutSection .skillSection li"))
    const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add("pillIn")
                obs.unobserve(entry.target)
            }
        })
    }, { threshold: 0.2 })
    pills.forEach(pill => observer.observe(pill))
</script>
<style>
    #aboutSection {
        display: flex;
        flex-direction: column;
        gap: 56px;
    }
    .sectionDivider {
        width: 100%;
        max-width: 120px;
        height: 1px;
        margin: 0 auto;
        background-color: var(--border-color);
    }
    .aboutTop {
        display: flex;
        column-gap: 60px;
        align-items: center;
    }
    .aboutText {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }
    .handwritten {
        font-family: var(--font-hand);
        font-size: clamp(22px, 2.5vw, 28px);
        font-weight: 600;
        color: var(--primary);
        margin: 0;
    }
    .leftAlign {
        text-align: left;
        margin: 0;
    }
    .bio {
        color: var(--secondary);
        line-height: 1.6;
        margin: 0;
        max-width: 58ch;
    }
    .aboutImage {
        position: relative;
        display: inline-flex;
    }
    .aboutImage img {
        width: 320px;
        height: 320px;
        object-fit: cover;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-lg);
        border: 6px solid var(--color-yellow);
        transition: transform var(--duration-base) var(--spring);
    }
    .aboutImage img:hover {
        transform: rotate(-2deg) scale(1.02);
    }
    .availabilityBadge {
        position: absolute;
        bottom: -14px;
        left: -14px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 999px;
        background-color: var(--bg-elevated);
        border: 1px solid var(--border-color);
        box-shadow: var(--shadow-md);
        color: var(--primary);
        font-size: 0.85rem;
        font-weight: 600;
        white-space: nowrap;
    }
    .availabilityDot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background-color: var(--brand-green);
        flex-shrink: 0;
    }
    .capabilities {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
    .capabilities > .bodyLg {
        color: var(--secondary);
        max-width: 640px;
    }
    .capabilities strong {
        color: var(--primary);
    }
    .skillSection {
        display: flex;
        flex-wrap: wrap;
        column-gap: 48px;
        row-gap: 28px;
        margin-top: 12px;
    }
    ul {
        list-style: none;
        padding-left: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 0;
    }
    li {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 999px;
        background-color: var(--pill-bg, var(--color-blue));
        color: var(--color-dark);
        font-size: 0.9rem;
        font-weight: 500;
        opacity: 0;
        transform: translateY(10px);
        transition: transform var(--duration-fast) var(--spring), opacity var(--duration-base) var(--spring);
    }
    li.pillIn {
        opacity: 1;
        transform: none;
        transition-delay: calc(var(--pill-i, 0) * 45ms);
    }
    li:hover {
        transform: translateY(-3px);
    }
    h4 {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 1.05rem;
        color: var(--primary);
        margin-bottom: 0.5rem;
    }
    h4::before {
        content: "";
        display: inline-block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: var(--section-accent, var(--color-blue));
        flex-shrink: 0;
    }
    @media only screen and (max-width: 768px) {
        .aboutTop {
            flex-direction: column-reverse;
            align-items: center;
            text-align: center;
        }
        .aboutText {
            align-items: center;
        }
        .leftAlign {
            text-align: center;
        }
        .aboutImage img {
            width: 220px;
            height: 220px;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .skillSection li {
            opacity: 1;
            transform: none;
            transition: none;
        }
    }
</style>
