---
import myImage from '../images/myPhoto.webp'
import { Image } from 'astro:assets';
const SKILLS = {
    Languages: ["HTML", "CSS", "JavaScript", "Python", "Dart"],
    Frameworks: ["React", "React-Native", "Flutter", "Bootstrap", "Svelte", "Astro"],
    Tools: ["Jira", "Figma", "Jenkins", "Eleventy"]
}
---
<section id = "aboutMeSection" class = "fullHeightSection">
    <h1 class = "sectionHeader">About me</h1>
    <div class = "aboutMeSection">
        <aside>
            <div>
                Hi! My name is Abhishek Prashant and I enjoy creating delightful experiences for people through code.
                I got interested in app development after following a <a class = "underlineLink" href = "https://fullstackopen.com/en/" target = "_blank">free course</a> online
                and got fully committed to it and never looked back.<br /><br />
                I am looking forward to grow as a developer and explore more exciting opportunities
            </div>
            <h3>Skills</h3>
            <div class = "skillSection">
                {Object.keys(SKILLS).map(key => (
                    <div class = "subSection">
                        <h4>{key}</h4>
                        <ul>
                            {SKILLS[key].map((skill: string) => <li>{skill}</li>)}
                        </ul>
                    </div>
                ))}
            </div>
        </aside>
        <aside>
            <Image
                src = {myImage}
                alt = "Portrait of Abhishek Prashant"
                loading = "lazy"
            />
        </aside>
    </div>
</section>
<style>
    #about-me {
        display: flex;
        flex-flow: column;
        justify-content: center;
    }
    .aboutMeSection {
        display: flex;
        column-gap: 48px;
        line-height: 1.6;
        color: var(--primary);
    }
    .skillSection {
        display: flex;
        flex-wrap: wrap;
        column-gap: 40px;
        row-gap: 24px;
    }
    aside:first-child {
        flex: 1;
    }
    aside:last-child img {
        width: 280px;
        height: 280px;
        object-fit: cover;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-lg);
        border: 1px solid var(--border-color);
    }
    ul {
        list-style: none;
        padding-left: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    li {
        display: flex;
        align-items: center;
        gap: 6px;
        color: var(--secondary);
    }
    li::before {
        content: "";
        width: 6px;
        height: 6px;
        flex-shrink: 0;
        border-radius: 50%;
        background-color: var(--brand-green);
    }
    h3 {
        margin-top: 3rem;
        margin-bottom: 1.5rem;
    }
    @media only screen and (max-width: 768px) {
        .aboutMeSection {
            flex-direction: column-reverse;
            align-items: center;
        }
        aside:last-child img {
            width: 200px;
            height: 200px;
        }
    }
</style>