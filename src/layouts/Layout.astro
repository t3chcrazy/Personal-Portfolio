---
export interface Props {
	title: string;
}
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta name="google-site-verification" content="1Ivpmo3wIqWk48mmbZWLDzULDAiaHRa-kUv9Jtzu5h0" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<!-- Primary Meta Tags -->
		<meta name="title" content={title}>
		<meta name="description" content="Software Engineer experienced with React, React-Native">
		<meta name="keywords" content="Abhishek Prashant, t3chcrazy, software engineer, developer portfolio, web developer, GitHub, personal website">
		<meta name="author" content="Abhishek Prashant">
		<link rel="canonical" href="https://t3chcrazy.github.io/">

		<!-- Open Graph / Facebook -->
		<meta property="og:title" content={title}>
		<meta property="og:description" content="Explore the personal portfolio of Abhishek Prashant, software engineer focused on modern full-stack web and mobile development.">
		<meta property="og:url" content="https://t3chcrazy.github.io/">
		<meta property="og:type" content="website">
		<meta property="og:image" content="favicon.svg">

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image">
		<meta property="twitter:url" content="https://t3chcrazy.github.io/">
		<meta property="twitter:title" content={title}>
		<meta property="twitter:description" content="Explore the personal portfolio of Abhishek Prashant, software engineer focused on modern full-stack web and mobile development.">
		<meta property="twitter:image" content="favicon.svg">
		<meta name="keywords" content="Software Developer,Abhishek Prashant,React,React-Native,Flutter">
		<meta name="robots" content="index, follow">
		<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
		<meta name="language" content="English">
		<title>{title}</title>
		<script is:inline>
			(function () {
				var stored = localStorage.getItem("theme");
				var theme = stored || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
				document.documentElement.setAttribute("data-theme", theme);
			})();
		</script>
	</head>
	<script is:inline type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "Person",
		"name": "Abhishek Prashant",
		"url": "https://t3chcrazy.github.io/",
		"sameAs": [
			"https://github.com/t3chcrazy",
			"https://linkedin.com/in/abhishek-prashant-app-dev/",
			"https://toptal.com/resume/abhishek-prashant"
		],
		"jobTitle": "Software Engineer",
		"worksFor": {
			"@type": "Organization",
			"name": "Freelance / Independent"
		}
	}
	</script>
	<script data-goatcounter="https://t3chcrazy.goatcounter.com/count"
    async src="//gc.zgo.at/count.js"></script>
	<body>
		<a href="#main" class="skipLink">Skip to main content</a>
		<slot />
	</body>
</html>
<style is:global>
	:root {
		--accent: 124, 58, 237;
		--accent-gradient: linear-gradient(45deg, rgb(var(--accent)), #da62c4 30%, white 60%);
		--nav-height: 90px;

		/** Motion */
		--ease: cubic-bezier(0.22, 1, 0.36, 1);
		--ease-out-back: cubic-bezier(0.34, 1.56, 0.64, 1);
		--duration-fast: 0.2s;
		--duration-base: 0.4s;
		--duration-slow: 0.65s;

		/** Layout */
		--contentHorizontalSpacing: 0 50px;
		--radius-sm: 8px;
		--radius-md: 14px;
		--radius-lg: 22px;

		/** Theme: light (default) */
		--brand-green: #0d9488;
		--brand-green-strong: #0b7c72;
		--cta-bg: #0b7c72;
		--cta-bg-hover: #095f58;
		--cta-text: #f6fdfc;
		--bg: #f6f6f6;
		--bg-elevated: #ffffff;
		--bg-inset: #eef0f0;
		--border-color: rgba(15, 23, 22, 0.1);
		--primary: #1f2933;
		--secondary: #5b6b70;
		--shadow-sm: 0 1px 3px rgba(15, 23, 22, 0.08), 0 1px 2px rgba(15, 23, 22, 0.06);
		--shadow-md: 0 8px 24px rgba(15, 23, 22, 0.08), 0 2px 6px rgba(15, 23, 22, 0.05);
		--shadow-lg: 0 16px 40px rgba(15, 23, 22, 0.12), 0 4px 10px rgba(15, 23, 22, 0.06);
		--focus-ring: 0 0 0 3px rgba(13, 148, 136, 0.45);
		color-scheme: light;
	}
	:root[data-theme="dark"] {
		--brand-green: #2dd4bf;
		--brand-green-strong: #5eead4;
		--cta-bg: #2dd4bf;
		--cta-bg-hover: #5eead4;
		--cta-text: #04201d;
		--bg: #10151a;
		--bg-elevated: #181f26;
		--bg-inset: #1f2830;
		--border-color: rgba(255, 255, 255, 0.1);
		--primary: #eef2f3;
		--secondary: #a3b0b5;
		--shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.4), 0 1px 2px rgba(0, 0, 0, 0.3);
		--shadow-md: 0 8px 24px rgba(0, 0, 0, 0.45), 0 2px 6px rgba(0, 0, 0, 0.3);
		--shadow-lg: 0 16px 40px rgba(0, 0, 0, 0.5), 0 4px 10px rgba(0, 0, 0, 0.3);
		--focus-ring: 0 0 0 3px rgba(45, 212, 191, 0.5);
		color-scheme: dark;
	}
	* {
		box-sizing: border-box;
	}
	h1,h2,h3,h4,h5,h6 {
		margin: 0;
	}
	h1.sectionHeader {
		margin: 30px 0 40px;
		padding-right: 20px;
		position: relative;
		z-index: 2;
		background-color: var(--bg);
		display: flex;
		align-items: center;
		color: var(--primary);
		transition: background-color var(--duration-base) var(--ease);
	}
	h1.sectionHeader::after {
		content: " ";
		display: block;
		position: relative;
		height: 1px;
		width: 50%;
		background-color: var(--border-color);
		margin-left: 10px;
	}
	html {
		font-family: system-ui, sans-serif;
		background-color: var(--bg);
		scroll-behavior: smooth;
		color: var(--primary);
		transition: background-color var(--duration-base) var(--ease), color var(--duration-base) var(--ease);
	}
	body {
		margin: 0;
	}
	code {
		font-family: Menlo, Monaco, Lucida Console, Liberation Mono, DejaVu Sans Mono,
			Bitstream Vera Sans Mono, Courier New, monospace;
	}
	.fullHeightSection {
		min-height: 100vh;
		padding: 2rem 0;
	}
	.skipLink {
		position: absolute;
		top: -100px;
		left: 1rem;
		z-index: 1000;
		background: var(--bg-elevated);
		color: var(--primary);
		padding: 0.75rem 1.25rem;
		border-radius: var(--radius-sm);
		box-shadow: var(--shadow-md);
		text-decoration: none;
		font-weight: 600;
		transition: top var(--duration-fast) var(--ease);
	}
	.skipLink:focus {
		top: 1rem;
	}
	a.underlineLink {
		display: inline-block;
		position: relative;
		text-decoration: none;
		color: var(--brand-green);
	}
	a.underlineLink::after {
        content: " ";
        position: absolute;
        width: 0;
        height: 1px;
        background-color: var(--brand-green);
        bottom: -2.5px;
        left: 0;
        transition: width 0.25s var(--ease);
    }
    a:hover::after,
    a:focus-visible::after {
        width: 100%;
    }
	:focus-visible {
		outline: none;
		box-shadow: var(--focus-ring);
		border-radius: var(--radius-sm);
	}
	section[id$='Section']:not(:first-child) {
		opacity: 0;
		transform: translateY(30px);
		transition: opacity var(--duration-slow) var(--ease), transform var(--duration-slow) var(--ease);
	}
	section[id$='Section']:not(:first-child).revealed {
		transform: translateY(0px);
		opacity: 1;
	}
	@media only screen and (max-width: 768px) {
        :root {
            --contentHorizontalSpacing: 0 35px;
        }
    }
    @media only screen and (max-width: 576px) {
        :root {
            --contentHorizontalSpacing: 0 25px;
        }
    }
	@media (prefers-reduced-motion: reduce) {
		*, *::before, *::after {
			animation-duration: 0.001ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.001ms !important;
			scroll-behavior: auto !important;
		}
		section[id$='Section']:not(:first-child) {
			opacity: 1;
			transform: none;
		}
	}
</style>
