---
export interface Props {
	title: string;
}
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta name="google-site-verification" content="1Ivpmo3wIqWk48mmbZWLDzULDAiaHRa-kUv9Jtzu5h0" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<!-- Primary Meta Tags -->
		<meta name="title" content={title}>
		<meta name="description" content="Abhishek Prashant is a frontend & fullstack software engineer specializing in React, React Native, and TypeScript, available for freelance and full-time work.">
		<meta name="keywords" content="Abhishek Prashant, t3chcrazy, frontend developer, fullstack developer, software engineer, freelance developer, React developer, React Native developer, TypeScript developer, web developer, mobile developer, developer portfolio">
		<meta name="author" content="Abhishek Prashant">
		<link rel="canonical" href="https://t3chcrazy.github.io/">

		<!-- Open Graph / Facebook -->
		<meta property="og:title" content={title}>
		<meta property="og:description" content="Frontend & fullstack software engineer specializing in React, React Native, and TypeScript. Open to freelance and full-time opportunities.">
		<meta property="og:url" content="https://t3chcrazy.github.io/">
		<meta property="og:type" content="website">
		<meta property="og:image" content="https://t3chcrazy.github.io/og-image.jpg">
		<meta property="og:image:width" content="1200">
		<meta property="og:image:height" content="1200">
		<meta property="og:image:alt" content="Abhishek Prashant, frontend & fullstack software engineer">

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image">
		<meta property="twitter:url" content="https://t3chcrazy.github.io/">
		<meta property="twitter:title" content={title}>
		<meta property="twitter:description" content="Frontend & fullstack software engineer specializing in React, React Native, and TypeScript. Open to freelance and full-time opportunities.">
		<meta property="twitter:image" content="https://t3chcrazy.github.io/og-image.jpg">
		<meta name="robots" content="index, follow">
		<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
		<meta name="language" content="English">
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Caveat:wght@500;700&display=swap" rel="stylesheet">
		<script is:inline>
			(function () {
				var stored = localStorage.getItem("theme");
				var theme = stored || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
				document.documentElement.setAttribute("data-theme", theme);
			})();
		</script>
	</head>
	<script is:inline type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "Person",
		"name": "Abhishek Prashant",
		"alternateName": "t3chcrazy",
		"url": "https://t3chcrazy.github.io/",
		"image": "https://t3chcrazy.github.io/og-image.jpg",
		"sameAs": [
			"https://github.com/t3chcrazy",
			"https://linkedin.com/in/abhishek-prashant-app-dev/",
			"https://toptal.com/resume/abhishek-prashant"
		],
		"jobTitle": "Frontend & Fullstack Software Engineer",
		"description": "Frontend & fullstack software engineer specializing in React, React Native, and TypeScript. Available for freelance and full-time opportunities.",
		"knowsAbout": ["React", "React Native", "TypeScript", "JavaScript", "Frontend Development", "Fullstack Development", "Node.js", "Mobile Development"],
		"worksFor": {
			"@type": "Organization",
			"name": "Qlik"
		}
	}
	</script>
	<body>
		<a href="#main" class="skipLink">Skip to main content</a>
		<slot />
	</body>
</html>
<style is:global>
	:root {
		--nav-height: 116px;

		/** Framer palette: Main Color / Hover Color tokens */
		--color-purple: rgb(227, 227, 255);
		--color-blue: rgb(227, 242, 255);
		--color-blue-hover: rgb(209, 232, 253);
		--color-yellow: rgb(255, 231, 169);
		--color-yellow-hover: rgb(254, 222, 141);
		--color-pink: rgb(255, 227, 251);
		--color-green: rgb(219, 245, 240);
		--color-green-hover: rgb(200, 240, 232);
		--color-lime: rgb(233, 250, 192);
		--color-powder: rgb(251, 235, 234);
		--color-light: rgb(247, 247, 247);
		--color-white: rgb(255, 255, 255);
		--color-dark: rgb(29, 29, 29);
		--accent: 124, 58, 237;
		--accent-gradient: linear-gradient(45deg, rgb(var(--accent)), #da62c4 30%, white 60%);

		/** Typography: Uncut Sans Variable substituted with Inter (closest freely-licensable match) */
		--font-sans: "Inter", system-ui, sans-serif;
		--font-hand: "Caveat", cursive;

		/** Motion: approximating Framer's spring-physics easing with cubic-bezier */
		--ease: cubic-bezier(0.22, 1, 0.36, 1);
		--ease-out-back: cubic-bezier(0.34, 1.56, 0.64, 1);
		--spring: cubic-bezier(0.16, 1, 0.3, 1);
		--duration-fast: 0.2s;
		--duration-base: 0.4s;
		--duration-slow: 0.65s;
		--duration-spring: 1.1s;

		/** Layout */
		--gutter: 50px;
		--contentHorizontalSpacing: 0 var(--gutter);
		--radius-sm: 12px;
		--radius-md: 20px;
		--radius-lg: 32px;

		/** Theme: light (default) */
		--brand-green: #0d9488;
		--brand-green-strong: #0b7c72;
		--cta-bg: var(--color-dark);
		--cta-bg-hover: #3a3a3a;
		--cta-text: var(--color-white);
		--bg: var(--color-light);
		--bg-elevated: var(--color-white);
		--bg-inset: var(--color-purple);
		--border-color: rgba(29, 29, 29, 0.1);
		--primary: var(--color-dark);
		--secondary: rgba(29, 29, 29, 0.65);
		--shadow-sm: 0 1px 3px rgba(29, 29, 29, 0.08), 0 1px 2px rgba(29, 29, 29, 0.06);
		--shadow-md: 0 8px 24px rgba(29, 29, 29, 0.08), 0 2px 6px rgba(29, 29, 29, 0.05);
		--shadow-lg: 0 16px 40px rgba(29, 29, 29, 0.12), 0 4px 10px rgba(29, 29, 29, 0.06);
		--focus-ring: 0 0 0 3px rgba(29, 29, 29, 0.35);
		color-scheme: light;
	}
	:root[data-theme="dark"] {
		--brand-green: #2dd4bf;
		--brand-green-strong: #5eead4;
		--cta-bg: var(--color-white);
		--cta-bg-hover: #e6e6e6;
		--cta-text: var(--color-dark);
		--bg: #171717;
		--bg-elevated: #1f1f1f;
		--bg-inset: #26263a;
		--border-color: rgba(255, 255, 255, 0.12);
		--primary: #f2f2f2;
		--secondary: rgba(242, 242, 242, 0.65);
		--shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.4), 0 1px 2px rgba(0, 0, 0, 0.3);
		--shadow-md: 0 8px 24px rgba(0, 0, 0, 0.45), 0 2px 6px rgba(0, 0, 0, 0.3);
		--shadow-lg: 0 16px 40px rgba(0, 0, 0, 0.5), 0 4px 10px rgba(0, 0, 0, 0.3);
		--focus-ring: 0 0 0 3px rgba(255, 255, 255, 0.35);
		color-scheme: dark;
	}
	* {
		box-sizing: border-box;
	}
	h1,h2,h3,h4,h5,h6 {
		margin: 0;
		font-family: var(--font-sans);
		font-weight: 500;
		letter-spacing: -0.03em;
	}
	html {
		font-family: var(--font-sans);
		background-color: var(--bg);
		scroll-behavior: smooth;
		color: var(--primary);
		transition: background-color var(--duration-base) var(--ease), color var(--duration-base) var(--ease);
	}
	p, span, li, a, div {
		font-family: var(--font-sans);
	}
	.display1 {
		font-weight: 500;
		letter-spacing: -0.05em;
		line-height: 1.05;
		font-size: clamp(38px, 6.5vw, 90px);
	}
	.display3 {
		font-weight: 500;
		letter-spacing: -0.04em;
		line-height: 1.125;
		font-size: clamp(28px, 4.5vw, 50px);
	}
	.bodyLg {
		font-weight: 375;
		line-height: 1.45;
		font-size: clamp(18px, 2vw, 24px);
	}
	body {
		margin: 0;
		overflow-x: clip;
	}
	code {
		font-family: Menlo, Monaco, Lucida Console, Liberation Mono, DejaVu Sans Mono,
			Bitstream Vera Sans Mono, Courier New, monospace;
	}
	.fullHeightSection {
		min-height: 100vh;
		padding: 2rem 0;
	}
	.skipLink {
		position: absolute;
		top: -100px;
		left: 1rem;
		z-index: 1000;
		background: var(--bg-elevated);
		color: var(--primary);
		padding: 0.75rem 1.25rem;
		border-radius: var(--radius-sm);
		box-shadow: var(--shadow-md);
		text-decoration: none;
		font-weight: 600;
		transition: top var(--duration-fast) var(--ease);
	}
	.skipLink:focus {
		top: 1rem;
	}
	a.underlineLink {
		display: inline-block;
		position: relative;
		text-decoration: none;
		color: var(--brand-green);
	}
	a.underlineLink::after {
        content: " ";
        position: absolute;
        width: 0;
        height: 1px;
        background-color: var(--brand-green);
        bottom: -2.5px;
        left: 0;
        transition: width 0.25s var(--ease);
    }
    a:hover::after,
    a:focus-visible::after {
        width: 100%;
    }
	:focus-visible {
		outline: none;
		box-shadow: var(--focus-ring);
		border-radius: var(--radius-sm);
	}
	section[id$='Section']:not(:first-child) {
		opacity: 0;
		transform: translateY(30px);
		transition: opacity var(--duration-slow) var(--ease), transform var(--duration-slow) var(--ease);
	}
	section[id$='Section']:not(:first-child).revealed {
		transform: translateY(0px);
		opacity: 1;
	}
	@media only screen and (max-width: 768px) {
        :root {
            --gutter: 35px;
        }
    }
    @media only screen and (max-width: 576px) {
        :root {
            --gutter: 25px;
        }
    }
	@media (prefers-reduced-motion: reduce) {
		*, *::before, *::after {
			animation-duration: 0.001ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.001ms !important;
			scroll-behavior: auto !important;
		}
		section[id$='Section']:not(:first-child) {
			opacity: 1;
			transform: none;
		}
	}
</style>
